# =============================================================================
# OpenAether — environment variables for CLOUD deploys
# =============================================================================
# Copy to a gitignored file, fill it in, and source it before any cloud `task`:
#
#     cp .env.example .env.sh && $EDITOR .env.sh && source .env.sh
#
# Every `.env*` is git-ignored (so `.env.sh`, `.env-anonimised.sh`, … never get
# committed) — only this `.env.example` is versioned. Set ONLY the provider(s)
# you actually use.
#
# Local Docker testing (`task local-up` / `task local-test`) needs NONE of this
# (the script injects a dummy passphrase). This file is only for cloud deploys.
#
# Credential model (resolved by scripts/lib/common.sh::s3_cred):
#   - Compute/API creds = the provider's native variables (SCW_*, OS_*, OUTSCALE_*).
#   - S3 (state + backups) creds = NAMESPACED by the cloud that HOLDS THE BUCKET:
#     <PU>_AWS_* (PU = SCW | OVH | OUTSCALE). The "-backup" store is opened with
#     the keys of whatever s3_replica_endpoint names in the tfvars — so backing a
#     Scaleway cluster up to Outscale needs OUTSCALE_AWS_*, nothing else.
#     <PU>_BACKUP_AWS_* stays available to give one store a SEPARATE key pair.
#     There is deliberately NO ambient AWS_* fallback (it could silently use one
#     provider's keys against another). `task` exports AWS_* internally.
#   - <PU>_BACKUP_AWS_* exists ONLY to give one store a key pair of its own. It
#     used to be set here for all three providers, aliasing the primary's keys —
#     which taught operators to edit it, and an edited copy silently outranks the
#     correct key. It is deliberately absent now. Uncomment only if you mean it:
#       # export OUTSCALE_BACKUP_AWS_ACCESS_KEY_ID=...
#       # export OUTSCALE_BACKUP_AWS_SECRET_ACCESS_KEY=...
#   - On Scaleway & Outscale, S3 == the API keys, so the <PU>_AWS_* point at them.
#     OVH needs DEDICATED S3 keys (`openstack ec2 credentials create`).
# =============================================================================

# --- REQUIRED (all providers) ------------------------------------------------
# >= 32 chars. Encrypts the tfstate (OpenTofu AES-GCM) AND the gpg-backed
# kube/talosconfig artifacts. Same passphrase for both; losing it loses the DR.
export TF_VAR_encryption_passphrase="change-me-to-a-long-random-passphrase-min-32-chars"


# =============================================================================
# Scaleway  (default management provider)
# =============================================================================
export SCW_ACCESS_KEY="SCWXXXXXXXXXXXXXXXXX"
export SCW_SECRET_KEY="00000000-0000-0000-0000-000000000000"
export SCW_DEFAULT_ORGANIZATION_ID="00000000-0000-0000-0000-000000000000"
export SCW_DEFAULT_PROJECT_ID="00000000-0000-0000-0000-000000000000"
export SCW_DEFAULT_REGION="fr-par"
export SCW_DEFAULT_ZONE="fr-par-1"

# S3 (state + backups). Scaleway S3 == API keys, so point them at SCW_*.
export SCW_AWS_ACCESS_KEY_ID="$SCW_ACCESS_KEY"
export SCW_AWS_SECRET_ACCESS_KEY="$SCW_SECRET_KEY"
export SCW_AWS_DEFAULT_REGION="$SCW_DEFAULT_REGION"
export SCW_AWS_DEFAULT_OUTPUT=json


# =============================================================================
# OVH  (OpenStack)
# =============================================================================
export OS_AUTH_URL="https://auth.cloud.ovh.net/"
export OS_INTERFACE=public
export OS_IDENTITY_API_VERSION=3
export OS_USERNAME="user-XXXXXXXXXXXX"
export OS_PASSWORD="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export OS_PROJECT_ID="00000000000000000000000000000000"
export OS_PROJECT_NAME="0000000000000000"
export OS_REGION_NAME="EU-WEST-PAR"          # 3-AZ compute region (b3-8 nodes)
export OS_USER_DOMAIN_NAME=Default
export OS_PROJECT_DOMAIN_NAME=default

# OVH Object Storage needs DEDICATED S3 keys (NOT OS_PASSWORD):
#   openstack ec2 credentials create
export OVH_AWS_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export OVH_AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export OVH_AWS_DEFAULT_REGION="eu-west-par"  # OVH object-storage region (e.g. gra/eu-west-par)
export OVH_AWS_DEFAULT_OUTPUT=json


# =============================================================================
# Outscale
# =============================================================================
export OUTSCALE_ACCESS_KEY_ID="XXXXXXXXXXXXXXXXXXXX"
export OUTSCALE_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export OUTSCALE_REGION="eu-west-2"

# OOS S3 == API keys, so point them at the OUTSCALE_* keys above.
export OUTSCALE_AWS_ACCESS_KEY_ID="$OUTSCALE_ACCESS_KEY_ID"
export OUTSCALE_AWS_SECRET_ACCESS_KEY="$OUTSCALE_SECRET_KEY"
export OUTSCALE_AWS_DEFAULT_REGION="$OUTSCALE_REGION"
export OUTSCALE_AWS_DEFAULT_OUTPUT=json

# =============================================================================
# Production host only: forbid `task teardown-all` in every shell that sources this file.
# Any value locks, an empty one too; a `.no-teardown-all` file at the repo root covers the other shells.
# =============================================================================
# export OA_NO_TEARDOWN_ALL=1
