// Renovate (GitHub App). Nothing here runs unattended: every bump is a
// PR, never auto-merged — applying a Talos/Kubernetes/provider bump still
// goes through `task rolling-replace` / `tofu plan` by hand.
//
// Native managers cover OpenTofu providers (`terraform`) and CI pins
// (`github-actions`). Everything
// else — Talos, Kubernetes, the OpenTofu CLI itself, Cilium, Flux — lives in
// a bash var, a workflow env key or a Terraform variable default, which
// Renovate can't see on its own. Those are tracked with the standard
// `# renovate: datasource=... depName=...` anchor comment placed one line
// above the value; see customManagers below.
//
// The three custom managers below match on the SHAPE of a value, not on the
// names of the keys that hold it: nine anchors were once inert because their
// file or their key had never been named here, and Renovate ignores an anchor
// it was not told to read without saying anything. `clea coverage`
// (scripts/clea/) now compares this file against every anchor in the tree and
// fails on the difference — `task lint` runs it.
//
// GitHub Actions and pre-commit hooks are both pinned to a commit SHA (with
// the tag kept as a trailing comment) rather than a mutable tag — a tag can
// be force-moved by the upstream repo (compromised or not) to point at
// different code without our CI/pre-commit config changing at all.
// `helpers:pinGitHubActionDigests` keeps the actions' SHAs current; the
// pre-commit custom manager below does the same for the hooks (the native
// `pre-commit` manager cannot: it reads the SHA as a tag and never bumps it).
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  automerge: false,
  platformAutomerge: false,
  // Daily, not weekly. "before 6am on monday" is a six-hour window once a week
  // — the narrowest useful schedule there is — and it was chosen to batch the
  // noise. Cléa's daily report does that job now, so the weekly window bought
  // nothing and cost a week of latency each time one was missed: helm 4.2.4
  // was published 2026-08-13, the window of 2026-08-17 came and went, and no
  // proposal ever arrived.
  schedule: ["before 6am"],
  timezone: "Europe/Paris",
  // Explicit, and it is the heartbeat. Issues were disabled on this repository
  // until 2026-08-21, so Renovate had nowhere to report a configuration problem
  // or its own state — three weeks of silence looked exactly like three weeks
  // of nothing to do. If this issue does not appear, the App is not running or
  // it is in `mode: silent`, which also writes no issue and no PR (#88).
  dependencyDashboard: true,
  // Mend runs this repository in `mode: silent` (hosted job log of 2026-10-03, #88): it scans and writes
  // nothing, no issue and no PR. This file is merged over that setting, so this turns the App on; the portal
  // toggle (Silent to Interactive) would do the same. If the next job log still says "running with
  // mode=silent", the override did not take and the portal is the only way.
  mode: "full",
  // Canary for the first full jobs: the dashboard lists every update and none opens a PR until its box is
  // ticked, so the first wave is chosen, not received. Remove once the dashboard has been seen (#88).
  dependencyDashboardApproval: true,
  labels: ["dependencies"],

  // Off: it reads the SHA in `rev:` as a tag ("Tag <sha> not found") and so can never bump a hook. The custom manager below reads the SHA and its tag comment.
  "pre-commit": { enabled: false },

  packageRules: [
    {
      description: "Routine OpenTofu provider bumps, bundled. Majors stay separate — bpg/proxmox and outscale/outscale in particular have no 1.0 yet and move fast on schema.",
      matchManagers: ["terraform"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "opentofu providers (minor/patch)",
    },
    {
      description: "GitHub Actions are isolated to CI, low risk — safe to bundle.",
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      description: "Talos/Kubernetes gate a running cluster's control plane. Bumping is a one-node-at-a-time `task rolling-replace`, never automated — see docs/upgrade.md.",
      matchPackageNames: ["siderolabs/talos", "kubernetes/kubernetes"],
      labels: ["dependencies", "cluster-version"],
    },
    {
      description: "setup-opentofu's `tofu_version` is already read by the anchored regex manager; the native `uses-with` dependency would raise a second, competing branch for the same lines.",
      matchManagers: ["github-actions"],
      matchDepTypes: ["uses-with"],
      enabled: false,
    },
    // #179: scaleway/scaleway >= 2.83.0 makes a call Feint answers 501. The Feint lane only: the real roots stay
    // `~> 2.68` on purpose. Delete with the cap in opentofu-feint/versions.tf and scripts/dev/feint.sh.
    {
      description: "Hold the Feint lane's Scaleway provider below 2.83.0, the cap in its versions.tf; left alone, Renovate rewrites that cap upward.",
      matchDatasources: ["terraform-provider"],
      matchPackageNames: ["scaleway/scaleway"],
      matchFileNames: ["infrastructure/opentofu-feint/**"],
      allowedVersions: "< 2.83.0",
    },
    // #241: siderolabs/talos provider 0.12.0 cannot render our machine configs for Talos 1.14.x. Provider only:
    // the Talos OS release has the same package name (github-releases) and must stay updatable. Delete when #241 closes.
    {
      description: "Hold the siderolabs/talos Terraform provider below 0.12.0 in every versions.tf.",
      matchDatasources: ["terraform-provider"],
      matchPackageNames: ["siderolabs/talos"],
      allowedVersions: "< 0.12.0",
    },
    {
      description: "Cilium/Flux versions here only bump the pinned variable. The actual manifest (bootstrap-manifests/cilium.yaml, flux-install.yaml) is regenerated by `task render-manifests` — run that and commit the diff before merging.",
      matchPackageNames: ["cilium", "fluxcd/flux2"],
      labels: ["dependencies", "needs-regen"],
    },
  ],

  customManagers: [
    {
      customType: "regex",
      description: "Pre-commit hooks pinned to a commit SHA with the tag in a trailing comment (`rev: <sha>  # v1.2.3`): bumps the tag and the SHA together. Hooks execute third-party code on every commit, the same supply-chain class as GitHub Actions, hence the SHA.",
      managerFilePatterns: ["/^\\.pre-commit-config\\.ya?ml$/"],
      matchStrings: [
        "repo:\\s*https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+?)(?:\\.git)?\\s*\\n\\s*rev:\\s*(?<currentDigest>[0-9a-f]{40})\\s*#\\s*(?<currentValue>v?\\d[\\w.+-]*)",
      ],
      datasourceTemplate: "github-tags",
    },
    {
      customType: "regex",
      description: "Terraform variable defaults — talos_version and kubernetes_version, in the cloud root AND in the local Docker lane. The `terraform` manager reads required_providers, never a variable default.",
      managerFilePatterns: ["/^infrastructure/.*variables\\.tf$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*default\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      customType: "regex",
      description: "Every version pinned in a shell script: VAR=\"x\", local VAR=\"x\", VAR=\"${VAR:-x}\". One manager for all of them, matched on the SHAPE. Four anchors — feint, task, tflint, kubectl-cnpg — sat in files no fileMatch named, and Renovate ignores an anchor it was not told to read, in silence. `clea coverage` now fails on that.",
      managerFilePatterns: ["/^scripts/.*\\.sh$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?\\s*\\n\\s*(?:local |export )?\\w+=\"\\$\\{\\w+:-(?<currentValue>[^}\"]+)\\}\"",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?\\s*\\n\\s*(?:local |export )?\\w+=\"(?<currentValue>[^\"$]+)\"",
      ],
    },
    {
      customType: "regex",
      description: "Workflow values the github-actions manager cannot see: an action input, an env pin, a pip install. Matched on the shape rather than on named keys — GITLEAKS_VERSION and HELM_VERSION in ci.yml were invisible because only tofu_version and TALOS_VERSION had ever been named, and nothing said so.",
      managerFilePatterns: ["/^\\.github/workflows/.*\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*[\\w.-]+:\\s*\"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*run: pip install \\S+==(?<currentValue>\\S+)",
      ],
    },
  ],
}
