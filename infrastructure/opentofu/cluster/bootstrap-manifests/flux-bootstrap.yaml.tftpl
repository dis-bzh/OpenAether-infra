# OpenAether — Flux bootstrap manifest (template)
# Injected as a Talos inline_manifest during the initial bootstrap.
# Remplace flux-root-app.yaml.tftpl.
#
# Variables OpenTofu :
#   ${git_repo_url}   — ex: https://github.com/dis-bzh/OpenAether.git
#   ${git_ref}        — ex: refs/tags/0.1.0, or refs/heads/main
#   ${cluster_role}   — ex: management (→ apps/flux/management)
#   ${cluster_id}     — e.g. openaether-dev-ovh (the cluster's UNIQUE identity)
#   ${backup_target_url} — ex: s3://s3-openaether-ovh-backups-dev@eu-west-par/
#   ${backup_s3_bucket} ${backup_s3_endpoint} — same destination, CNPG format
#   ${namespace}      — ex: flux-system
---
# Cluster identity, consumed through `postBuild.substituteFrom` by the bricks
# that must distinguish themselves from ANOTHER cluster. Today: the restic
# restic (apps/flux/base/22-backup.yaml), because several clusters share
# cross-provider buckets, and a restic repository is only readable with the
# RESTIC_PASSWORD of the cluster that created it — two clusters on the same
# bloquent mutuellement (« already initialized »).
#
# ⚠️ A brick declaring `substituteFrom` on this ConfigMap FAILS if it is absent.
# That is deliberate: a loud failure beats an empty repository path and a silent
# collision between clusters.
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-identity
  namespace: ${namespace}
  labels:
    openaether.io/managed: "true"
data:
  CLUSTER_NAME: ${cluster_id}
  # Destination for VOLUME backups (Longhorn), in the expected format:
  # s3://<bucket>@<region>/. The bucket pre-exists and its credentials live in
  # OpenBao; only the (non-secret) location travels here, because
  # `backup-target` is a STRING on the Longhorn side and cannot be fed from a
  # Secret. ⚠️ Must match the bucket seeded in
  # `secret/backup/s3-primary`.
  BACKUP_TARGET_URL: ${backup_target_url}
  # Same destination, two formats: Longhorn wants `s3://bucket@region/`,
  # CNPG wants the bucket and endpoint separately (barmanObjectStore).
  BACKUP_S3_BUCKET: ${backup_s3_bucket}
  BACKUP_S3_ENDPOINT: ${backup_s3_endpoint}
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: openaether
  namespace: ${namespace}
spec:
  interval: 1m
  url: ${git_repo_url}
  ref:
    name: ${git_ref}
  timeout: 60s
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: openaether-platform
  namespace: ${namespace}
spec:
  interval: 10m
  retryInterval: 2m
  timeout: 5m
  sourceRef:
    kind: GitRepository
    name: openaether
  path: ./apps/flux/${cluster_role}
  prune: true
  wait: false
  # Injects the ref into the flux layer objects (including the self-reapplied
  # GitRepository — gitception trap: without it the ref gets overwritten by the
  # apps-side default on the first reconcile).
  postBuild:
    substitute:
      GIT_REF: ${git_ref}
