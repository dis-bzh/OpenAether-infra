# OpenAether — Flux bootstrap manifest (template)
# Injected as a Talos inline_manifest during the initial bootstrap.
# Replaces flux-root-app.yaml.tftpl.
#
# OpenTofu variables:
#   ${git_repo_url}   — e.g. https://github.com/dis-bzh/OpenAether.git
#   ${git_ref}        — e.g. refs/tags/0.3.1, or refs/heads/main
#   ${cluster_role}   — e.g. management (→ apps/flux/management)
#   ${cluster_id}     — e.g. openaether-dev-ovh (the cluster's UNIQUE identity)
#   ${backup_target_url} — e.g. s3://s3-openaether-ovh-backups-dev@eu-west-par/
#   ${backup_s3_bucket} ${backup_s3_endpoint} — same destination, CNPG format
#   ${namespace}      — e.g. flux-system
#   flux_git_verify_enabled / flux_git_verify_keys — OPT-IN OpenPGP verification of the commit at HEAD (default off, then NOTHING of it is rendered).
#   openbao_pgp_keys, openbao_threshold — recovery-share holders (list of base64 PGP public keys; quorum). Not interpolated: a list.
---
# Cluster identity, consumed through `postBuild.substituteFrom` by the bricks
# that must distinguish themselves from ANOTHER cluster. Today: the restic
# restic (apps/flux/base/22-backup.yaml), because several clusters share
# cross-provider buckets, and a restic repository is only readable with the
# RESTIC_PASSWORD of the cluster that created it — two clusters on the same
# bloquent mutuellement (« already initialized »).
#
# ⚠️ A brick declaring `substituteFrom` on this ConfigMap FAILS if it is absent.
# That is deliberate: a loud failure beats an empty repository path and a silent
# collision between clusters.
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-identity
  namespace: ${namespace}
  labels:
    openaether.io/managed: "true"
data:
  CLUSTER_NAME: ${cluster_id}
  # Destination for VOLUME backups (Longhorn), in the expected format:
  # s3://<bucket>@<region>/. The bucket pre-exists and its credentials live in
  # OpenBao; only the (non-secret) location travels here, because
  # `backup-target` is a STRING on the Longhorn side and cannot be fed from a
  # Secret. ⚠️ Must match the bucket seeded in
  # `secret/backup/s3-primary`.
  BACKUP_TARGET_URL: ${backup_target_url}
  # Same destination, two formats: Longhorn wants `s3://bucket@region/`,
  # CNPG wants the bucket and endpoint separately (barmanObjectStore).
  BACKUP_S3_BUCKET: ${backup_s3_bucket}
  BACKUP_S3_ENDPOINT: ${backup_s3_endpoint}
%{ if length(openbao_pgp_keys) > 0 ~}
---
# OpenBao PRODUCTION bootstrap: the operators' PGP PUBLIC keys. openbao-init reads this ConfigMap and encrypts one
# recovery share to each key; without it the bootstrap is a development one (apps foundation/vault/README.md).
# The namespace is created here because this manifest is applied before Flux reconciles anything; the `namespaces`
# brick adopts it and adds its labels.
apiVersion: v1
kind: Namespace
metadata:
  name: foundation-vault
  labels:
    openaether.io/managed: "true"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: openbao-operator-keys
  namespace: foundation-vault
  labels:
    openaether.io/managed: "true"
data:
  threshold: "${openbao_threshold}"
%{ for i, k in openbao_pgp_keys ~}
  pgp-${i + 1}: "${k}"
%{ endfor ~}
%{ endif ~}
%{ if flux_git_verify_enabled ~}
---
# OPT-IN (flux_git_verify): armored OpenPGP PUBLIC keys of the people and bots whose commits Flux may apply, including
# GitHub's web-flow key for squash merges. It sits BEFORE the GitRepository in this same manifest, so the first
# reconcile finds it. Public data. The apps repo must carry the same spec.verify (components/git-verify), or the
# first reconcile adds or removes the block (gitception).
apiVersion: v1
kind: Secret
metadata:
  name: git-signers
  namespace: ${namespace}
  labels:
    openaether.io/managed: "true"
type: Opaque
stringData:
%{ for i, k in flux_git_verify_keys ~}
  signer-${i + 1}.asc: |
    ${indent(4, trimspace(k))}
%{ endfor ~}
%{ endif ~}
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: openaether
  namespace: ${namespace}
spec:
  interval: 1m
  url: ${git_repo_url}
  ref:
    name: ${git_ref}
  timeout: 60s
%{ if flux_git_verify_enabled ~}
  verify:
    mode: HEAD
    secretRef:
      name: git-signers
%{ endif ~}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: openaether-platform
  namespace: ${namespace}
spec:
  interval: 10m
  retryInterval: 2m
  timeout: 5m
  sourceRef:
    kind: GitRepository
    name: openaether
  path: ./apps/flux/${cluster_role}
  prune: true
  wait: false
  # Injects the ref into the flux layer objects (including the self-reapplied
  # GitRepository — gitception trap: without it the ref gets overwritten by the
  # apps-side default on the first reconcile).
  postBuild:
    substitute:
      GIT_REF: ${git_ref}
