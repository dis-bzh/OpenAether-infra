# ==============================================================================
# Workload Cluster — Proxmox (single host or multi-host PVE cluster)
# Client applications cluster (spoke). Same host shape as management-proxmox but
# cluster_role = "workload" — no CAPI, just the CNI+Flux socle + picked manifests.
#
# Prerequisites: identical to management-proxmox.tfvars.example (PROXMOX_VE_* env,
# host bridge/NAT/nftables, imported Talos image, pve-firewall disabled). See that
# file + the module README.
# ==============================================================================

cluster_name       = "openaether-pmx"
environment        = "prod"
cluster_role       = "workload"
# talos_version / kubernetes_version: leave unset to inherit the tracked defaults of
# cluster/variables.tf (the pair each release measures); pin them here only to hold a cluster back.
talos_bootstrap    = true

node_distribution = {
  proxmox = {
    control_planes = 1
    workers        = 1

    node_names          = ["pve1"]
    # node_names        = ["pve1", "pve2", "pve3"]  # HA: 1 CP per physical host
    # talos_image_file_id optional — defaults to "<iso_datastore_id>:iso/talos-<talos_version>-nocloud-amd64.img"
    # (downloaded by `task talos-image PROVIDER=proxmox`). Override only for a different path:
    # talos_image_file_id = "local:iso/talos-1.13.3-nocloud-amd64.img"

    network_bridge = "vmbr1"
    network_cidr   = "10.0.0.0/24"
    gateway_ip     = "10.0.0.1"
    apiserver_vip  = "10.0.0.100"

    enable_bastion = false
    host_public_ip = "203.0.113.10"
    host_ssh_user  = "root"

    cpu_cores = 4
    memory_mb = 8192
  }
}

# worker_storage = { ... }   # see management-proxmox.tfvars.example

admin_ip = ["YOUR_IP/32"]

# bastion_ssh_keys = { proxmox = "ssh-ed25519 AAAA... user@host" }  # only if enable_bastion = true

git_repo_url = "https://github.com/dis-bzh/OpenAether-apps.git"
# Pin the platform: a commit on a branch would otherwise reach a running
# cluster within the reconcile interval. refs/heads/<branch> to test.
git_ref          = "refs/heads/main"

# --- Backup / DR object stores (any S3-compatible store) ----------------------
# Proxmox has no native object storage, so both endpoints are external. Each is
# opened with the keys of the cloud that HOLDS it — the OVH replica below reads
# OVH_AWS_* from .env.sh, not the Scaleway keys the primary uses.
s3_primary_endpoint = "https://s3.fr-par.scw.cloud"
s3_primary_region   = "fr-par"
s3_replica_endpoint = "https://s3.gra.io.cloud.ovh.net" # OVH: prod crosses providers, or drop to environment = "dev"
s3_replica_region   = "gra"
