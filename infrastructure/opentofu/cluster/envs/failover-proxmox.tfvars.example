# ==============================================================================
# Failover Management Cluster on Proxmox (cross-provider)
# A SECOND management cluster, on-premise (Proxmox), for when your PRIMARY
# management provider (a cloud) is lost/unavailable. Meant to rebuild a full
# management cluster. Use this only when Proxmox is NOT your primary provider.
#
# Note on terminology: re-running your own management-proxmox.tfvars rebuilds
# the cluster on the SAME provider (the everyday recovery). This file is the
# CROSS-provider failover — same role, different (on-prem) target.
#
# Usage: there is no failover command yet — see "Cross-provider failover" in
# ../README.md. Untested sketch:
#   tofu apply -var-file=envs/failover-proxmox.tfvars -var talos_bootstrap=true
#
# Prerequisites:
#   export PROXMOX_VE_ENDPOINT=https://<host-ip-or-fqdn>:8006/
#   export PROXMOX_VE_API_TOKEN='terraform@pve!tofu=<uuid-secret>'
#   export PROXMOX_VE_INSECURE=true        # self-signed 8006 cert
#
#   On the host (manual / Ansible — NOT managed by this tofu, see
#   modules/providers/proxmox/README.md "Host NAT/DNAT" + "Host hardening"):
#     - a bridge vmbr1 for 10.0.0.0/24, host holding the gateway IP, NAT egress
#     - nftables: DNAT public :80/:443 -> the worker, SSH from admin_ip only
#     - the Talos nocloud image imported (build via ../../talos-image), referenced
#       by talos_image_file_id
#     - pve-firewall disabled (raw nftables owns the perimeter)
#
# After rebuild:
#   1. Flux bootstrap → syncs from Git automatically
#   2. Re-register spoke clusters: task register-spoke CLUSTER=<name> PROVIDER=<provider>
#   3. Update DNS for management endpoints (if using ExternalDNS — automated in Phase 4)
# ==============================================================================

# ⚠️ NEVER EXECUTED. This describes the disaster-recovery drill (primary provider
# gone, cluster rebuilt on another) that is still undone (docs/status.md).
# Nothing here has been deployed, so read it as a design intent, not as a proven
# procedure. Note also that `ROLE=failover` only picks THIS FILE: the Flux overlay
# and the bucket segment come from cluster_role below, which is "management".

cluster_name       = "openaether"
environment        = "prod"
cluster_role       = "management"
# talos_version / kubernetes_version: leave unset to inherit the tracked defaults of
# cluster/variables.tf (the pair each release measures); pin them here only to hold a cluster back.
talos_bootstrap    = false # Set to true after infra is up

node_distribution = {
  proxmox = {
    control_planes = 1
    workers        = 1

    node_names          = ["pve1"]                                   # `pvesh get /nodes`
    # node_names        = ["pve1", "pve2", "pve3"]                   # HA: 1 CP per physical host
    # talos_image_file_id optional — defaults to "<iso_datastore_id>:iso/talos-<talos_version>-nocloud-amd64.img"
    # (downloaded by `task talos-image PROVIDER=proxmox`). Override only for a different path:
    # talos_image_file_id = "local:iso/talos-1.13.3-nocloud-amd64.img"

    # Networking (static, no cloud LB/NAT). gateway_ip = the host's vmbr1 IP.
    network_bridge = "vmbr1"
    network_cidr   = "10.0.0.0/24"
    gateway_ip     = "10.0.0.1"
    apiserver_vip  = "10.0.0.100" # spare IP the CP owns; posé dès 1 CP for 3-CP later

    # Host-as-bastion (default): the Proxmox host is the SSH jump. Supply its
    # public IP + user (the same access you keep for Debian/Proxmox upgrades).
    enable_bastion = false
    host_public_ip = "203.0.113.10" # the failover host's public IPv4
    host_ssh_user  = "root"

    # Node sizing — adjust to the failover host's headroom.
    cpu_cores = 4
    memory_mb = 8192
  }
}

# --- Worker data storage (dedicated, encrypted) ------------------------------
# Extra disk(s) per worker → encrypted Talos user volumes (LUKS2, /var/mnt/<name>).
# Leave unset for no dedicated data disk (worker uses the system disk only).
# worker_storage = {
#   disks = [{ size_gb = 100 }]
#   volumes = [
#     { name = "local-path-provisioner", disk_match = "!system_disk", min_size = "20GB", max_size = "25GB" },
#     { name = "longhorn", disk_match = "!system_disk", grow = true },
#   ]
# }

admin_ip = ["YOUR_IP/32"]

# Not used with host-as-bastion (no bastion VM). Only needed if enable_bastion = true.
# bastion_ssh_keys = { proxmox = "ssh-ed25519 AAAA... user@host" }

git_repo_url = "https://github.com/dis-bzh/OpenAether-apps.git"
# Pin the platform: a commit on a branch would otherwise reach a running
# cluster within the reconcile interval. refs/heads/<branch> to test.
git_ref          = "refs/heads/main"

# --- Backup / DR object stores ------------------------------------------------
# This failover cluster runs when your primary provider is DOWN, so its PRIMARY
# state lives on an external S3 (Proxmox has no native object storage — point
# these at a Scaleway/OVH bucket), and it replicates BACK to the primary once it
# recovers. That replica is opened with the primary provider's own keys — the
# cloud s3_replica_endpoint names, not this one.
s3_primary_endpoint = "https://s3.fr-par.scw.cloud" # failover state store (primary is down)
s3_primary_region   = "fr-par"
s3_replica_endpoint = "https://s3.gra.io.cloud.ovh.net" # OVH: prod crosses providers, or drop to environment = "dev"
s3_replica_region   = "gra"
