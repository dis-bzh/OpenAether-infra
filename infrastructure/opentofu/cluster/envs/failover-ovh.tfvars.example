# ==============================================================================
# Failover Management Cluster on OVH (cross-provider)
# A SECOND management cluster, on OVH, for when your PRIMARY management provider
# is lost/unavailable. Meant to rebuild a full management cluster.
# Use this only when OVH is NOT your primary provider.
#
# Note on terminology: re-running your own management-<provider>.tfvars rebuilds
# the cluster on the SAME provider (the everyday recovery). This file is the
# CROSS-provider failover — same role, different cloud.
#
# Usage: there is no failover command yet — see "Cross-provider failover" in
# ../README.md. Untested sketch:
#   tofu apply -var-file=envs/failover-ovh.tfvars -var talos_bootstrap=true
#
# After rebuild:
#   1. Flux bootstrap → syncs from Git automatically
#   2. Re-register spoke clusters: task register-spoke CLUSTER=<name> PROVIDER=<provider>
#   3. Update DNS for management endpoints (if using ExternalDNS — automated in Phase 4)
# ==============================================================================

# ⚠️ NEVER EXECUTED. This describes the disaster-recovery drill (primary provider
# gone, cluster rebuilt on another) that is still undone (docs/status.md).
# Nothing here has been deployed, so read it as a design intent, not as a proven
# procedure. Note also that `ROLE=failover` only picks THIS FILE: the Flux overlay
# and the bucket segment come from cluster_role below, which is "management".

cluster_name       = "openaether"
environment        = "prod"
cluster_role       = "management"
talos_version      = "v1.13.3"
kubernetes_version = "v1.35.3"
talos_bootstrap    = false # Set to true after infra is up

node_distribution = {
  ovh = {
    control_planes     = 3
    workers            = 2
    region             = "EU-WEST-PAR"
    # c3-8 (4 vCPU / 8 GB), not b3-8 (2 vCPU): measured 2026-08-15, three b3-8
    # workers sit at ~99% of CPU requests with the platform on them, so no node
    # can be drained and `rolling-replace --upgrade` cannot finish. A rolling
    # upgrade needs one node's worth of spare capacity — see docs/upgrade.md.
    flavor_name        = "c3-8"
    # image_id optional — defaults to looking up "talos-ovh-amd64-<talos_version>" by
    # name (published by talos-image). Override only if you use a different name/UUID:
    # image_id           = "TALOS_IMAGE_ID"
    network_name       = "Ext-Net"
    # One zone puts all control planes in one failure domain and `cluster-verify` ends
    # red (#38); in a multi-AZ region, list one zone per control plane.
    availability_zones = ["nova"]
    bastion_image_id   = "Ubuntu 22.04"
  }
}

# --- Worker data storage (dedicated, encrypted) ------------------------------
# Decouples cloud block volumes (`disks`, attached to each worker) from the
# encrypted Talos user volumes (`volumes`, LUKS2, mounted at /var/mnt/<name>).
# Leave unset for no dedicated data disk (workers use the system disk only).
#
# Dev — one shared 50GB disk, two volumes (local-path + Longhorn):
# worker_storage = {
#   disks = [{ size_gb = 50 }]
#   volumes = [
#     { name = "local-path-provisioner", disk_match = "!system_disk", min_size = "20GB", max_size = "25GB" },
#     { name = "longhorn", disk_match = "!system_disk", grow = true },
#   ]
# }
# Prod (single large shared disk): disks = [{ size_gb = 500 }] (same volumes).
# Prod (dedicated disks): disks = [{ size_gb = 100 }, { size_gb = 400 }] and
#   discriminate by size, e.g. disk_match "disk.size < 200000000000u" vs "> ...".

admin_ip = ["YOUR_IP/32"]

bastion_ssh_keys = {
  ovh = ["ssh-ed25519 AAAA... user@host"]
}

git_repo_url     = "https://github.com/dis-bzh/OpenAether-apps.git"
# Pin the platform: a commit on a branch would otherwise reach a running
# cluster within the reconcile interval. refs/heads/<branch> to test.
git_ref          = "refs/heads/main"

# --- Backup / DR object stores ------------------------------------------------
# This failover cluster runs when your primary provider is DOWN, so its PRIMARY
# state lives on OVH (reachable), and it replicates BACK to the primary once it
# recovers. That replica is opened with the primary provider's own keys — the
# cloud s3_replica_endpoint names, not this one. Derived buckets (parts come from this file, each with a "-backup"
# twin):
#   state            -> s3-<cluster_name>-ovh-tfstate-<environment>
#   kube/talosconfig -> s3-<cluster_name>-ovh-management-<environment>
s3_primary_endpoint = "https://s3.gra.io.cloud.ovh.net" # failover state on OVH (your primary is down)
s3_primary_region   = "gra"
s3_replica_endpoint = "https://s3.fr-par.scw.cloud"     # replicate back to Scaleway on recovery
s3_replica_region   = "fr-par"
