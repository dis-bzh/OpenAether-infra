# ==============================================================================
# Workload Cluster — Scaleway (spoke)
# Client applications cluster. Managed by the management cluster via Flux hub.
# ==============================================================================

cluster_name       = "openaether-scaleway"
environment        = "prod"
cluster_role       = "workload"
# talos_version / kubernetes_version: leave unset to inherit the tracked defaults of
# cluster/variables.tf (the pair each release measures); pin them here only to hold a cluster back.
talos_bootstrap    = true
# The platform, not only the machines. Both default to FALSE: a copy of this file WITHOUT these lines builds an
# infrastructure-only cluster (Talos + Cilium: no Flux, no apps, no public load balancer), and `task cluster-verify`
# then reports flux-system as red. Set them as shown for the platform; the Day-1 seeding follows (scripts/ops/seed-openbao.sh).
deploy_flux     = true
deploy_app_lb   = true

node_distribution = {
  scaleway = {
    control_planes = 3
    workers        = 3
    region         = "fr-par"
    zone           = "fr-par-1"
    instance_type  = "POP2-4C-16G" # meets the sizing floor, see docs/capacity.md (DEV1-M is l_ssd and not in fr-par-3)
    # image_name left unset — auto-derives to "talos-scaleway-amd64-${talos_version}".
    zones          = ["fr-par-1", "fr-par-2", "fr-par-3"]
  }
}

# --- Worker data storage (dedicated, encrypted) ------------------------------
# Decouples cloud block volumes (`disks`, attached to each worker) from the
# encrypted Talos user volumes (`volumes`, LUKS2, mounted at /var/mnt/<name>).
# Leave unset for no dedicated data disk (workers use the system disk only).
#
# Dev — one shared 50GB disk, two volumes (local-path + Longhorn):
# worker_storage = {
#   disks = [{ size_gb = 50 }]
#   volumes = [
#     { name = "local-path-provisioner", disk_match = "!system_disk", min_size = "20GB", max_size = "25GB" },
#     { name = "longhorn", disk_match = "!system_disk", grow = true },
#   ]
# }
# Prod (single large shared disk): disks = [{ size_gb = 500 }] (same volumes).
# Prod (dedicated disks): disks = [{ size_gb = 100 }, { size_gb = 400 }] and
#   discriminate by size, e.g. disk_match "disk.size < 200000000000u" vs "> ...".

admin_ip = ["YOUR_IP/32"]

bastion_ssh_keys = {
  scaleway = ["ssh-ed25519 AAAA... user@host"]
}

git_repo_url     = "https://github.com/dis-bzh/OpenAether-apps.git"
# Pin the platform: a commit on a branch would otherwise reach a running
# cluster within the reconcile interval. refs/heads/<branch> to test.
git_ref          = "refs/tags/0.3.2"

# --- Backup / DR object stores ------------------------------------------------
# Derived buckets (you don't set them) — parts come from this file,
# and each has a "-backup" twin:
#   state            -> s3-<cluster_name>-scaleway-tfstate-<environment>
#   kube/talosconfig -> s3-<cluster_name>-scaleway-workload-<environment>
#   Loki logs        -> s3-<cluster_name>-scaleway-logs-<environment>   (no replica twin)
# PRIMARY = this cluster's own store. REPLICA = its "-backup" twin, opened with
# the keys of the cloud s3_replica_endpoint names (an Outscale replica needs
# OUTSCALE_AWS_* in .env.sh) — never with this cluster's own keys.
s3_primary_endpoint = "https://s3.fr-par.scw.cloud"
s3_primary_region   = "fr-par"
s3_replica_endpoint = "https://s3.gra.io.cloud.ovh.net" # OVH: prod crosses providers, or drop to environment = "dev"
s3_replica_region   = "gra"

# --- Node system disk --------------------------------------------------------
# 50 GB per node by default (scw_root_volume_size_gb): the application stack puts ~11 GB of images on a node and Talos
# keeps them on the system volume, ~4 GB under its size. With deploy_flux the value must be at least 40 (validated).
# scw_root_volume_size_gb = 50
