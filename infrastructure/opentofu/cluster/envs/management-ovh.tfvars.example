# ==============================================================================
# Management Cluster — OVH Public Cloud (hub)
# NOT in the client data path. Use this when OVH is your PRIMARY management provider.
#
# Prerequisites:
#   export OS_AUTH_URL=https://auth.cloud.ovh.net/v3
#   export OS_USERNAME=<ovh_user>
#   export OS_PASSWORD=<ovh_password>
#   export OS_PROJECT_ID=<ovh_project_id>
#   export OS_REGION_NAME=EU-WEST-PAR           # or eu-west-par (3-AZ)
#   export OS_USER_DOMAIN_NAME=Default
#   export OS_PROJECT_DOMAIN_NAME=Default
#   (easiest: download the "OpenStack RC file v3" from the OVH console and source it)
# ==============================================================================

cluster_name    = "openaether"

# --- Bucket namespace ---------------------------------------------------------
# S3 bucket names are NOT scoped to your account: Scaleway documents them unique
# "in our whole platform", OVH "within OVHcloud", Outscale per region. Whoever
# creates a name owns it for everyone else, so leaving this empty means you
# inherit whichever names are still free. `task bucket-suffix` prints one.
# Pick it ONCE — changing it later orphans every bucket you already have.
# bucket_suffix = "a1b2c3"
# dev, not prod: `task cluster-up` refuses, before spending, a prod cluster with
# no state object yet whose s3_replica_endpoint is on the primary's endpoint or
# cloud, and every example below ships them equal. Switch to "prod" in the same edit as pointing
# s3_replica_endpoint at ANOTHER provider.
environment     = "dev"
cluster_role    = "management"
talos_bootstrap = true
# talos_version / kubernetes_version: leave unset to inherit the tracked
# defaults from cluster/variables.tf. The image is resolved by NAME from
# talos_version (same as Scaleway) unless image_id below is set, and it is the
# medium a node INSTALLS from — not the version it runs. Bumping talos_version
# alone changes the
# installer in the machine config, which `rolling-replace --upgrade` then
# applies to running nodes; rebuild the image via
# `task talos-image PROVIDER=ovh` when you want NEW nodes to start there
# too. The two differing is expected, not a mistake.

node_distribution = {
  ovh = {
    control_planes     = 3
    workers            = 2
    region             = "EU-WEST-PAR"
    # c3-8 (4 vCPU / 8 GB), not b3-8 (2 vCPU): measured 2026-08-15, three b3-8
    # workers sit at ~99% of CPU requests with the platform on them, so no node
    # can be drained and `rolling-replace --upgrade` cannot finish. A rolling
    # upgrade needs one node's worth of spare capacity — see docs/upgrade.md.
    flavor_name        = "c3-8"
    # image_id optional — defaults to looking up "talos-ovh-amd64-<talos_version>" by
    # name (published by talos-image). Override only if you use a different name/UUID:
    # image_id           = "TALOS_IMAGE_ID"
    network_name       = "Ext-Net"
    availability_zones = ["nova"]
    bastion_image_id   = "Ubuntu 22.04"
  }
}

# --- Worker data storage (dedicated, encrypted) ------------------------------
# Decouples cloud block volumes (`disks`, attached to each worker) from the
# encrypted Talos user volumes (`volumes`, LUKS2, mounted at /var/mnt/<name>).
# Leave unset for no dedicated data disk (workers use the system disk only).
#
# Dev — one shared 50GB disk, two volumes (local-path + Longhorn):
# worker_storage = {
#   disks = [{ size_gb = 50 }]
#   volumes = [
#     { name = "local-path-provisioner", disk_match = "!system_disk", min_size = "20GB", max_size = "25GB" },
#     { name = "longhorn", disk_match = "!system_disk", grow = true },
#   ]
# }
# Prod (single large shared disk): disks = [{ size_gb = 500 }] (same volumes).
# Prod (dedicated disks): disks = [{ size_gb = 100 }, { size_gb = 400 }] and
#   discriminate by size, e.g. disk_match "disk.size < 200000000000u" vs "> ...".

admin_ip = ["YOUR_IP/32"]

bastion_ssh_keys = {
  ovh = ["ssh-ed25519 AAAA... user@host"]
}

git_repo_url     = "https://github.com/dis-bzh/OpenAether-apps.git"
# Pin the platform: a commit on a branch would otherwise reach a running
# cluster within the reconcile interval. refs/heads/<branch> to test.
git_ref          = "refs/heads/main"

# --- Backup / DR object stores (OVH S3-compatible Object Storage) -------------
# Derived buckets (you don't set them) — parts come from this file,
# and each has a "-backup" twin:
#   state            -> s3-<cluster_name>-ovh-tfstate-<environment>
#   kube/talosconfig -> s3-<cluster_name>-ovh-management-<environment>
# PRIMARY = this cluster's own store. REPLICA = its "-backup" twin, opened with
# the keys of the cloud s3_replica_endpoint names — a Scaleway replica needs
# SCW_AWS_* in .env.sh, never this cluster's own keys.
s3_primary_endpoint = "https://s3.gra.io.cloud.ovh.net"
s3_primary_region   = "gra"
s3_replica_endpoint = "https://s3.gra.io.cloud.ovh.net" # prod: e.g. SCW https://s3.fr-par.scw.cloud
s3_replica_region   = "gra"                              # prod: e.g. fr-par
