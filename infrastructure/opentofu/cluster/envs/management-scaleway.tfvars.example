# ==============================================================================
# Management Cluster — Scaleway HA (3 zones)
# It is NOT in the data path of client workloads.
# ==============================================================================

cluster_name    = "openaether"

# --- Bucket namespace ---------------------------------------------------------
# S3 bucket names are NOT scoped to your account: Scaleway documents them unique
# "in our whole platform", OVH "within OVHcloud", Outscale per region. Whoever
# creates a name owns it for everyone else, so leaving this empty means you
# inherit whichever names are still free. `task bucket-suffix` prints one.
# Pick it ONCE — changing it later orphans every bucket you already have.
# bucket_suffix = "a1b2c3"
# Protection of the buckets that hold copies and logs (read by scripts/internal/ensure-buckets.sh): off | versioned |
# governance | compliance. Default off changes nothing. Whether your provider supports each is not verified here, and
# object lock usually has to be set when a bucket is CREATED: docs/backup-policy.md, section 3.
# backup_immutability   = "versioned"
# backup_retention_days = 60
# dev, not prod: `task cluster-up` refuses, before spending, a prod cluster with
# no state object yet whose s3_replica_endpoint is on the primary's endpoint or
# cloud, and every example below ships them equal. Switch to "prod" in the same edit as pointing
# s3_replica_endpoint at ANOTHER provider.
environment     = "dev"
cluster_role    = "management"
talos_bootstrap = true
# The platform, not only the machines. Both default to FALSE: a copy of this file WITHOUT these lines builds an
# infrastructure-only cluster (Talos + Cilium: no Flux, no apps, no public load balancer), and `task cluster-verify`
# then reports flux-system as red. Set them as shown for the platform; the Day-1 seeding follows (scripts/ops/seed-openbao.sh).
deploy_flux     = true
deploy_app_lb   = true
# talos_version / kubernetes_version: leave unset to inherit the tracked
# defaults from cluster/variables.tf (Renovate keeps those current) — a
# stale copy here once caused a real deploy failure (image_name below
# auto-derives from talos_version, drifted out of sync with the built image).
node_distribution = {
  scaleway = {
    control_planes = 3 # HA needs 3; new Scaleway accounts may have a per-type quota of 1 — request an increase (Console → Quotas) or start with 1
    workers        = 4 # not 3: lab 16 measured 172% of one worker's CPU requested on 2 (cluster-roll refuses above (n-1)*100%); the full platform measured ~9 vCPU (223-228% of a worker) in lab 21, above the 8 vCPU 3 workers leave; 4 pass at ~75% of the limit, docs/capacity.md
    # "5 workers zone-HA" profile (infra #389): set `workers = 5` and nothing else. Workers go round-robin over `zones`, so 5 land
    # 2 + 2 + 1 on fr-par-1/2/3 and the loss of ANY ONE zone leaves 3 workers (300%) for about 245% requested (measured on Scaleway, lab 22). With 4 (this example)
    # the zone holding two workers cannot be lost: 2 stay (200%) for 224%. `task failure-domain-check PROVIDER=scaleway` says which
    # (script test: scripts/dev/test-failure-domain-check.sh). Costs one more instance; check your quota first (docs/capacity.md).
    region         = "fr-par"
    zone           = "fr-par-1"
    instance_type  = "POP2-4C-16G" # 4 vCPU / 16 GB: meets the sizing floor (docs/capacity.md). Block-storage, dedicated CPU, in all 3 fr-par zones (DEV1-M is l_ssd + not in fr-par-3; DEV1-L isn't in fr-par-3 either — verify any instance_type change against the API before assuming 3-zone coverage)
    # image_name left unset — auto-derives to "talos-scaleway-amd64-${talos_version}".
    zones = ["fr-par-1", "fr-par-2", "fr-par-3"]
  }
}

# --- Worker data storage (dedicated, encrypted) ------------------------------
# Decouples cloud block volumes (`disks`, attached to each worker) from the
# encrypted Talos user volumes (`volumes`, LUKS2, mounted at /var/mnt/<name>).
# Leave unset for no dedicated data disk (workers use the system disk only).
#
# Dev — one shared 50GB disk, two volumes (local-path + Longhorn):
# worker_storage = {
#   disks = [{ size_gb = 50 }]
#   volumes = [
#     { name = "local-path-provisioner", disk_match = "!system_disk", min_size = "20GB", max_size = "25GB" },
#     { name = "longhorn", disk_match = "!system_disk", grow = true },
#   ]
# }
# Prod (single large shared disk): disks = [{ size_gb = 500 }] (same volumes).
# Prod (dedicated disks): disks = [{ size_gb = 100 }, { size_gb = 400 }] and
#   discriminate by size, e.g. disk_match "disk.size < 200000000000u" vs "> ...".

# Node DNS (optional): DNS-over-TLS (tcp/853, Talos 1.14+) for the nodes' own resolver.
# Rules and trade-offs: modules/talos/variables.tf.
# node_nameservers = [
#   { address = "9.9.9.9", tls_server_name = "dns.quad9.net" },
#   { address = "149.112.112.112", tls_server_name = "dns.quad9.net" },
# ]

# Node and flow logs (optional, ANSSI PA-012 R9; off by default). Rules, plaintext caveat and
# rollout order: modules/talos/variables.tf and docs/hardening.md.
# node_log_forwarding    = { endpoint = "tcp://127.0.0.1:5170" }   # receiver on every node (hostNetwork)
# cilium_hubble_drop_log = true                                    # policy denials in the cilium-agent log

# Node baseline and time sources (optional, ANSSI BP-028 R9/R12 and PA-012 R5; off by default). Risks, prerequisites
# and the deviation table: modules/talos/variables.tf and docs/hardening.md. Try on a throwaway cluster first.
# node_baseline     = { sysctls = true, worker_default_seccomp = true, pod_pids_limit = 4096 }
# node_time_servers = ["YOUR_NTP_1", "YOUR_NTP_2", "YOUR_NTP_3"]   # also in bastion_baseline.time_servers

# Node network filtering (optional, ANSSI PA-022 R17/R20; both off by default).
# restrict_inter_node has no effect here (OVH and Outscale only; no security-group layer to swap), so it is not offered.
# node_firewall_mode = "port_allowlist" is NOT inert: each listed port (apid, kube-apiserver, kubelet, etcd, ...) accepts
# ONLY the listed sources and drops the rest (ports that are not listed stay open). A source missing from node_firewall
# (the load balancer range, a second subnet, a wrong pod range) breaks the cluster. Per-rule sources: docs/network.md 6.
# Read docs/network.md section 6 and LAB-CHECKLIST B24 first; a throwaway cluster first.
# node_firewall_mode  = "port_allowlist"
# node_firewall       = { node_cidrs = ["YOUR_NODE_SUBNET"], bastion_cidrs = ["YOUR_BASTION_SUBNET"] }

admin_ip = ["YOUR_IP/32"]

bastion_ssh_keys = {
  scaleway = ["ssh-ed25519 AAAA... user@host"]
}

git_repo_url     = "https://github.com/dis-bzh/OpenAether-apps.git"
# Pin the platform: a commit on a branch would otherwise reach a running
# cluster within the reconcile interval. refs/heads/<branch> to test.
git_ref          = "refs/tags/0.3.1"

# OpenBao recovery-share holders (only read when deploy_flux = true). OpenBao unseals itself; what the operators hold are
# RECOVERY shares, for an emergency root token. Each key is a person's PGP PUBLIC key, `gpg --export <id> | base64 -w0`
# (it needs an encryption subkey; `task cluster-up` checks it and prints the fingerprint). Empty = a DEVELOPMENT bootstrap (one plaintext
# share in a labelled Secret, which can not become a production one).
# environment = "prod" with deploy_flux = true refuses to plan without at least 3. Then, once: escrow the seal key
# (OpenAether-apps foundation/vault/README.md, Day 0).
# openbao_recovery_pgp_keys = [
#   "mQGNBF...",   # operator 1
#   "mQGNBF...",   # operator 2
#   "mQGNBF...",   # operator 3
# ]
# openbao_recovery_threshold = 2   # default: a majority

# --- Flux Git source verification (OPT-IN, default off) ---------------------------
# Flux then applies only a HEAD commit signed by one of these OpenPGP keys (gpg --armor --export <id>), GitHub's
# web-flow key included if you squash-merge. Read docs/signed-commits.md first; the apps overlay must carry the
# same block (components/git-verify). Public keys only.
# flux_git_verify = {
#   enabled     = true
#   public_keys = ["-----BEGIN PGP PUBLIC KEY BLOCK-----\n...\n-----END PGP PUBLIC KEY BLOCK-----"]
# }

# --- Backup / DR object stores ------------------------------------------------
# Derived buckets (you don't set them) — parts come from this file,
# and each has a "-backup" twin:
#   state            -> s3-<cluster_name>-scaleway-tfstate-<environment>
#   kube/talosconfig -> s3-<cluster_name>-scaleway-management-<environment>
#   Loki logs        -> s3-<cluster_name>-scaleway-logs-<environment>   (no replica twin)
# PRIMARY = this cluster's own object store. REPLICA = its "-backup" twin.
# Each is opened with the credentials of the cloud that HOLDS it: the replica
# uses the keys of whatever s3_replica_endpoint points at. So a Scaleway cluster
# backing up to Outscale needs OUTSCALE_AWS_* in .env.sh — and no SCW_BACKUP_*.
# Leaving the replica equal to the primary is the single-provider shape: legal,
# stated out loud at deploy, and it survives a deleted bucket but not a lost
# provider. `prod` refuses that shape (task cluster-up, before it spends).
s3_primary_endpoint = "https://s3.fr-par.scw.cloud"
s3_primary_region   = "fr-par"
s3_replica_endpoint = "https://s3.fr-par.scw.cloud" # prod: e.g. OVH https://s3.gra.io.cloud.ovh.net
s3_replica_region   = "fr-par"                       # prod: e.g. gra

# --- Node system disk --------------------------------------------------------
# 50 GB per node by default (scw_root_volume_size_gb): the application stack puts ~11 GB of images on a node and Talos
# keeps them on the system volume, ~4 GB under its size. With deploy_flux the value must be at least 40 (validated).
# scw_root_volume_size_gb = 50

# Audit sink (infra #318, docs/audit-sink.md): a second copy of the Kubernetes audit log OUTSIDE the cluster, object lock, client-side
# encryption. Off by default. Also needs the apps component audit-log-sink and a dedicated key pair
# (scripts/ops/backup-key-recipe.sh <this file> audit-sink; OA_AUDIT_SINK_S3_ACCESS_KEY_ID / OA_AUDIT_SINK_S3_SECRET_ACCESS_KEY at seed time).
# audit_sink_placement          = "other_provider"   # other_provider | same_provider_other_region | both
# audit_sink_endpoint           = "https://s3.gra.io.cloud.ovh.net"   # a Scaleway cluster: the sink on OVH
# audit_sink_region             = "gra"
# audit_sink_secondary_endpoint = ""                 # only with "both": the cluster's own provider, another region
# audit_sink_secondary_region   = ""
# audit_sink_prefix             = "audit"
# audit_sink_lock_mode          = "governance"       # compliance needs audit_sink_compliance_ack = true (irreversible until the retention ends)
# audit_sink_retention_days     = 365
