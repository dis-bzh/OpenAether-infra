# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# .agent
.agent/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work
go.work.sum

# env files (contain secrets) — but version the documented template.
# `.env*` (no dot) also catches variants like `.env-anonimised.sh`.
.env*
!.env.example

# Editor/IDE
# .idea/
# .vscode/

# Security - Secrets & Keys
*.pem
*.key
*.p12
*.pfx
*.crt
# Talos & Kubernetes Credentials
kubeconfig*
talosconfig*
# ⚠️ Those two globs have no slash, so they match at ANY depth — including a
# SCRIPT whose name starts with them. `scripts/ops/talosconfig-new.sh` was
# silently ignored on 2026-08-24, which would have pushed a Taskfile calling a
# file that is not in the repository. Keep the globs broad (they guard a public
# repo against a real credential) and exempt the code by name.
!scripts/**/talosconfig*.sh
!scripts/**/kubeconfig*.sh
controlplane.yaml
worker.yaml

# OpenTofu / Terraform
.terraform/
# Isolated TF_DATA_DIR for `task validate` — keeps the static check runnable
# without cloud credentials (see the validate task in Taskfile.yml).
.terraform-validate/
# Same isolation for the emulated-cloud lane (docs/emulated-cloud.md).
.terraform-feint/
# One data dir per cluster (TF_DATA_DIR), so two providers cannot steal the
# backend pointer from each other.
.terraform-*/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# ...and anything derived from one. `*.tfvars` does not match
# `management-ovh.tfvars.bak`, so an ordinary `cp` before an edit put real
# IPs and account ids one `git add -A` away from a public repository.
*.tfvars.*
!*.tfvars.example
*.tfplan
plan

# Talos image builder (downloaded/converted image artifacts — state is in S3)
infrastructure/opentofu/talos-image/.talos-image-cache/

# Local test cluster (state + generated configs)
infrastructure/opentofu-local/.terraform/
infrastructure/opentofu-local/.terraform.lock.hcl
infrastructure/opentofu-local/terraform.tfstate*
infrastructure/opentofu-local/kubeconfig
infrastructure/opentofu-local/talosconfig
infrastructure/opentofu/cluster/bootstrap-manifests/cilium-local.yaml

# Emulated-cloud lane (Feint): disposable state, plus the temporary local-backend
# override the plan lane drops into the cluster root. That override is removed by
# a trap — if you ever see it in a working tree, a run died hard: delete it.
infrastructure/opentofu-feint/terraform.tfstate*
infrastructure/opentofu/cluster/zz-feint-backend_override.tf
# `feint evidence`'s own output: regenerated per run, timestamped, never the
# thing to commit. `.feint-evidence-<provider>.json` (the pinned baseline) is
# the committed artifact, deliberately outside this directory.
coverage/

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Transcript of the last plan/apply, read by explain-failure.sh to quote the
# provider on a failure. It holds real addresses and ids — never commit it.
.tofu-run.log

# Phase 2 SSH tunnel PIDs (Talos API via bastion)
infrastructure/opentofu/.talos-tunnels.pids
infrastructure/opentofu/cluster/.talos-tunnels.pids
infrastructure/opentofu/.talos-bastion-known-hosts
infrastructure/opentofu/cluster/.talos-bastion-known-hosts

# Claude Code session artifacts (local state, not project content)
# … except the shared SessionStart hook, which has to be versioned so it applies
# to every Claude Code on the web session.
.claude/*
!.claude/settings.json
!.claude/hooks
.claude/hooks/*
!.claude/hooks/session-start.sh
# … and the skills, which are project instructions, not local state. Duplicated
# in OpenAether-apps on purpose; `task apps-validate` fails if they diverge.
!.claude/skills

# Extracted kubeconfigs + escrow (never commit)
*.kubeconfig
restic-escrow-*.txt

# Python bytecode caches (committed by accident on 2026-07-28).
__pycache__/
*.pyc

# Probe samples from a roll — kept so the next investigation has a baseline.
.upgrade-probe-*.log

# Cléa writes this on a local `task clea-scan`; on a probe branch the committed
# artefact is clea-probe.json, not this.
clea-state.json

# task pipeline-audit's own output — a local run's report, not an artefact
# this repository commits.
plumber-report.json

# Rung receipts (scripts/dev/rung-receipt.py): written by the harness, pasted
# into a pull request, never committed.
.receipts/
